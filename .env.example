# ==============================================================================
# Drone Telemetry System - Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# General Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_KEY=drone_telemetry_secure_token_2026

# Database URL
# For Docker Compose (PostgreSQL with TimescaleDB):
DATABASE_URL=postgresql+asyncpg://telemetry_user:telemetry_pass@localhost:5432/telemetry_db
# For zero-dependency local testing without PostgreSQL, uncomment:
# DATABASE_URL=sqlite+aiosqlite:///./telemetry.db

# Docker-internal database URL (used inside container):
DOCKER_DATABASE_URL=postgresql+asyncpg://telemetry_user:telemetry_pass@timescaledb:5432/telemetry_db

# ------------------------------------------------------------------------------
# Collector Configuration
# ------------------------------------------------------------------------------
DRONE_ID=DRONE-ALPHA-01
COLLECTOR_NAME="Apex Scout Quad"

# Flight Controller Connection String
# SITL / Mission Planner / QGroundControl UDP forward:
FC_CONNECTION_STRING=udpin:0.0.0.0:14550
# Mission Planner TCP forwarding:
# FC_CONNECTION_STRING=tcp:127.0.0.1:5760
# Real Pixhawk hardware via USB Serial:
# Windows: FC_CONNECTION_STRING=COM7
# Linux/RPi: FC_CONNECTION_STRING=/dev/ttyACM0
FC_BAUD_RATE=57600

# Backend WebSocket Ingestion Endpoint
BACKEND_WS_URL=ws://127.0.0.1:8000/api/v1/telemetry/ws/ingest
# Docker-internal backend URL (used inside container):
DOCKER_BACKEND_WS_URL=ws://backend:8000/api/v1/telemetry/ws/ingest

# Collector Data Rates (Hz)
STREAM_RATE_POSITION_HZ=10
STREAM_RATE_ATTITUDE_HZ=10
STREAM_RATE_VFR_HZ=5
STREAM_RATE_STATUS_HZ=2
STREAM_RATE_RC_HZ=2

# Reconnect & Queue Limits
WS_RECONNECT_MIN_DELAY=1.0
WS_RECONNECT_MAX_DELAY=15.0
QUEUE_MAX_SIZE=5000

# ------------------------------------------------------------------------------
# Simulator Configuration (for testing without physical hardware)
# ------------------------------------------------------------------------------
SIM_TARGET_HOST=127.0.0.1
SIM_TARGET_PORT=14550
SIM_DRONE_ID=DRONE-ALPHA-01
